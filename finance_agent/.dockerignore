# Docker ignore for finance_agent
# Reduces build context size

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Tests
tests/
*_test.py
test_*.py

# Documentation
docs/
*.md
!README.md

# Development files
.env.example
*.log

# OS
.DS_Store
Thumbs.db

# Terraform
terraform/

# MCP server venvs (we'll install deps directly)
mcp_servers/*/.venv/
